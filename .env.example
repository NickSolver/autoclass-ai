APP_NAME="Автокласс AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# В docker compose значения DB_* задаются в compose.yaml и имеют приоритет.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=

# Сессии хранятся в БД: это нужно для списка и завершения сессий пользователя.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_EXPIRE_ON_CLOSE=false
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# В эксплуатации (HTTPS) обязательно true.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Очередь и кеш — Redis (в docker compose задаются в compose.yaml). Обработчик — сервис horizon.
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# В разработке письма (ссылки сброса пароля) пишутся в storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@portal.invalid"
MAIL_FROM_NAME="${APP_NAME}"

# Ограничение попыток входа: попыток в минуту на пару логин+IP.
AUTH_LOGIN_MAX_ATTEMPTS=5
# Срок жизни ссылки сброса пароля, минут.
AUTH_PASSWORD_RESET_EXPIRE=30

VITE_APP_NAME="${APP_NAME}"

# Двухфакторная аутентификация (TOTP).
AUTH_MFA_GRACE_DAYS=7
AUTH_MFA_TRUST_DAYS=30
AUTH_MFA_STEP_UP_MINUTES=15
